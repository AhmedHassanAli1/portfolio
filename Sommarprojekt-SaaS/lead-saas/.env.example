# Kopiera denna fil till .env och fyll i egna värden.
# .env checkas INTE in i git (se .gitignore).

# SMTP (t.ex. Ethereal för test/utveckling: https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_password
SMTP_FROM=LeadFlow <your_ethereal_user>

# JWT
JWT_SECRET=replace_with_a_long_random_string

# Stripe (testnyckel, se backend/stripe.js)
STRIPE_SECRET_KEY=sk_test_your_key_here
